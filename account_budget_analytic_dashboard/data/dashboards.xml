<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="dashboard_analytic_budget" model="spreadsheet.dashboard">
        <field name="name">Budget</field>
        <field
            name="spreadsheet_binary_data"
            type="base64"
            file="account_budget_analytic_dashboard/data/files/budget_dashboard.json"
        />
        <field
            name="main_data_model_ids"
            eval="[(4, ref('account_budget_analytic_dashboard.model_account_analytic_budget_report'))]"
        />
        <field
            name="dashboard_group_id"
            ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"
        />
        <field
            name="group_ids"
            eval="[Command.link(ref('account.group_account_user'))]"
        />
        <field name="sequence">40</field>
        <field name="is_published">True</field>
    </record>
</odoo>
