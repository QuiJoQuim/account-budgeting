<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_analytic_plan_form_view" model="ir.ui.view">
        <field name="name">account.analytic.plan.form.budget</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_budget_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-line-chart">
                    <field name="budget_line_count"
                           string="Budget Lines"
                           widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Budgets" name="budgets">
                    <group>
                        <group string="Recursive Totals">
                            <field name="budget_planned_amount"/>
                            <field name="budget_practical_amount"/>
                        </group>
                        <group string="Achievement">
                            <field name="budget_theoretical_amount"/>
                            <field name="budget_percentage"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="account_analytic_plan_tree_view" model="ir.ui.view">
        <field name="name">account.analytic.plan.list.budget</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_applicability" position="after">
                <field name="budget_line_count" optional="show"/>
                <field name="budget_planned_amount" optional="show"/>
                <field name="budget_practical_amount" optional="show"/>
                <field name="budget_theoretical_amount" optional="hide"/>
                <field name="budget_percentage" optional="show"/>
            </field>
        </field>
    </record>

    <record id="account_analytic_plan_budget_search_view" model="ir.ui.view">
        <field name="name">account.analytic.plan.search.budget</field>
        <field name="model">account.analytic.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <filter name="root_plans"
                        string="Root Plans"
                        domain="[('parent_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_parent"
                            string="Parent Plan"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="account_analytic_plan_budget_tree_view" model="ir.ui.view">
        <field name="name">account.analytic.plan.list.budget.overview</field>
        <field name="model">account.analytic.plan</field>
        <field name="arch" type="xml">
            <list string="Analytic Plans Budget Overview">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="budget_line_count"/>
                <field name="budget_planned_amount" sum="Planned Amount"/>
                <field name="budget_practical_amount" sum="Practical Amount"/>
                <field name="budget_theoretical_amount" sum="Theoretical Amount"/>
                <field name="budget_percentage"/>
            </list>
        </field>
    </record>

    <record id="account_analytic_plan_budget_action" model="ir.actions.act_window">
        <field name="name">Analytic Plans Budget Overview</field>
        <field name="res_model">account.analytic.plan</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account_analytic_plan_budget_tree_view"/>
        <field name="search_view_id" ref="account_analytic_plan_budget_search_view"/>
        <field name="context">{'search_default_group_by_parent': 1}</field>
    </record>

    <menuitem id="menu_account_analytic_plan_budget_overview"
              name="Analytic Plans Budget Overview"
              parent="account_budget_oca.menu_act_crossovered_budget_view"
              action="account_analytic_plan_budget_action"
              sequence="20"/>
</odoo>
